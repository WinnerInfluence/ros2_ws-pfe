<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="advanced_drl_lab">
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <include><uri>model://sun</uri></include>

    <model name="lab_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 8 1</size></box></geometry><material><script><name>Gazebo/FlatBlack</name></script></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 8 1</size></box></geometry><material><script><name>Gazebo/FlatBlack</name></script></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.2 1</size></box></geometry><material><script><name>Gazebo/FlatBlack</name></script></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.2 1</size></box></geometry><material><script><name>Gazebo/FlatBlack</name></script></material></visual></link></model>

  </world>
</sdf>