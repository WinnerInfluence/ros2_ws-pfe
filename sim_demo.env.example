export ROS_DISTRO=humble
export WS_PATH="${WS_PATH:-$HOME/ros2_ws}"
export PFE_GAZEBO_GUI=0
export TRAINING_CONTRACT="${WS_PATH}/src/safe_drl_nav/safe_drl_nav/training_contract.yaml"
export PFE_WORLD="${WS_PATH}/src/safe_drl_nav/safe_drl_nav/sim_assets/worlds/eval_maze.world"
export TURTLEBOT3_MODEL=burger
export PFE_RESET_SERVICE_WAIT="${PFE_RESET_SERVICE_WAIT:-45}"
export PFE_ENV_STEP_SLEEP="${PFE_ENV_STEP_SLEEP:-0.05}"

export SIM_DEMO_API_HOST=127.0.0.1
export SIM_DEMO_API_PORT=5001
export SIM_WS_LOCAL_PORT=9091

export SIM_DEMO_PAPER_EVAL="${SIM_DEMO_PAPER_EVAL:-0}"
export SIM_DEMO_EVAL_EPISODES="${SIM_DEMO_EVAL_EPISODES:-5}"

# Optional reverse-proxy source IP for firewall rules (set if exposing upload API)
# export SIM_DEMO_PROXY_IP=

# export UPLOAD_API_KEY=

export WEB_SKIP_TELEMETRY_SIDECAR=1
